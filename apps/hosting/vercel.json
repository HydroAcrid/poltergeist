{
  "framework": null,
  "functions": {
    "api/enter.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/enter?view=haunt"
    },
    {
      "source": "/:view(haunt|stage|team|debug)",
