{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true,
    "baseUrl": ".",
    // Until World's workspace lands (same approach as apps/brain): contract
    // files resolve zod from this package, and imports of World-owned contract
    // files that are not on main yet fall back to test/shims/contracts.
    "rootDirs": ["../../packages/contracts/src", "./test/shims/contracts"],
    "paths": {
      "zod": ["./node_modules/zod"],
      "@poltergeist/contracts/*": ["../../packages/contracts/src/*", "./test/shims/contracts/*"]
    }
  },
  "include": [
    "server/**/*.ts",
    "dev/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "../../packages/contracts/src/haunt.ts",
    "../../packages/contracts/src/verdict.ts",
    "../../packages/contracts/src/scoreboard.ts",
    "../../packages/contracts/src/operator.ts"
  ]
}
