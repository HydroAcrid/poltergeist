{
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(node:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
