# Copy to .env (never commit .env). Cloud instances set these as host secrets.

# --- identity ---
PG_LANE=                      # world | brain | crowd   (this laptop's lane)
PG_INSTANCE=local             # local | staging | prod
PG_PUBLIC_URL=http://localhost:8787
PORT=8787

# --- which lane modules run in this hub (default fake) ---
PG_WORLD=fake                 # real | fake
PG_BRAIN=fake
PG_CROWD=fake

# --- keys & tokens (secrets) ---
GEMINI_API_KEY=
PG_TOKEN_WORLD=               # bus publish token for /stage
PG_TOKEN_BRAIN=
PG_TOKEN_CROWD=
PG_OPERATOR_TOKEN=            # /operator, /data, /api/crowd/queue
PG_MCP_TOKEN=                 # bearer for /mcp (coach)

# --- Genie guardrails (world) ---
PG_ALLOW_GENIE=0              # 1 only on the world laptop; staging/prod ignore this and always allow
PG_GENIE_MAX_USD=40           # local 40 · staging 80 · prod 260
PG_GENIE_MAX_DURATION_MS=60000  # local/staging 60000 · prod 90000
PG_GENIE_USD_PER_SEC=0.10

# --- models (VERIFY IDs at kickoff) ---
PG_MODEL_GENIE=genie-4
PG_MODEL_PERCEPTION=gemini-robotics-er-2-preview
PG_MODEL_MODERATION=gemini-4-hydrogen
PG_MODEL_REFEREE=gemini-4-neon
PG_MODEL_AUDIT=gemini-4-argon
PG_MANAGED_AGENT=             # latest Antigravity managed agent id (Carbon); check docs

# --- adapters (free versions for tests) ---
PG_PERCEPTION_ADAPTER=fixture # er2 | hydrogen | neon | fixture
# By default, a server with GEMINI_API_KEY uses Gemini. Use rules-only for offline demos.
# PG_MODERATION_ADAPTER=hydrogen
PG_JUDGE_ADAPTER=rule         # neon | rule
PG_COACH_ADAPTER=scripted     # managed | scripted

# --- crowd tuning ---
PG_HAUNT_INTERVAL_MS=12000
PG_HAUNT_MAX_PER_EPISODE=6

# --- storage / tests ---
PG_DATA_DIR=./data
PG_FAKE_SPEED=4
PG_LIVE=0                     # 1 enables @live tests (paid calls) - humans only
